# Copy to .env and fill in. Never commit real secrets.
# Only variable NAMES are referenced by the runtime; values stay in the environment.

AIR_DATA_DIR=~/.air
AIR_HOST=127.0.0.1
AIR_PORT=8765
AIR_LOG_LEVEL=INFO

# Optional: enable cloud providers by setting keys. Ollama needs no key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
